rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. دوال مساعدة أمنية (Security Helpers)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && request.auth.uid == storeId;
    }

    // ضفنا دالة exists عشان لو اليوزر لسه جديد ومستنده مكملش، ميضربش كراش للنسخة القديمة
    function isStoreEmployee(storeId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath) && get(userPath).data.storeId == storeId;
    }

    function canAccessStore(storeId) {
      return isStoreOwner(storeId) || isStoreEmployee(storeId);
    }

    // ضفنا دالة exists هنا برضه كحماية
    function hasPermission(permissionName) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath) && (
        get(userPath).data.role == 'owner' || 
        (get(userPath).data.role == 'employee' && get(userPath).data.get('permissions', {}).get(permissionName, false) == true)
      );
    }

    // ==========================================
    // 2. قواعد لوحة تحكم الإدارة (Admin Panel Rules)
    // ==========================================
    
    match /admin_stats/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // 3. القواعد الأساسية لتطبيق الهاتف والإدارة
    // ==========================================

    match /device_registrations/{deviceId} {
      allow get: if isAuthenticated() && resource.data.ownerUid == request.auth.uid || isAdmin();
      allow create: if isAuthenticated() && 
                       request.resource.data.keys().hasAll(['deviceId', 'ownerUid']) && 
                       request.resource.data.ownerUid == request.auth.uid || isAdmin();
      allow update, delete, list: if isAdmin(); 
    }

    match /license_keys/{keyId} {
      allow read: if isAdmin(); 
      allow update: if (isAuthenticated() && !resource.data.isUsed) || isAdmin(); 
      allow create, delete: if isAdmin(); 
    }

    match /users/{userId} {
      allow get: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow update: if (isAuthenticated() && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'storeId', 'isActive'])) 
                    || isAdmin();
      allow get, delete: if (isAuthenticated() && isStoreOwner(resource.data.storeId)) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow create, update: if (isAuthenticated() && isStoreOwner(request.resource.data.storeId)) || isAdmin();
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

   match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isStoreOwner(storeId) || isAdmin();
      allow delete: if isAdmin();

      // 🌟 التعديل السحري: ضفنا isStoreOwner في الأول عشان يعدي المالك فوراً
      match /stats/summary {
        allow read: if isStoreOwner(storeId) || (canAccessStore(storeId) && hasPermission('viewDashboardStats')) || isAdmin();
        allow write: if isStoreOwner(storeId) || (canAccessStore(storeId) && (hasPermission('createTransaction') || hasPermission('createDebt') || hasPermission('collectDebt'))) || isAdmin();
      }
      match /daily_stats/{day} {
        allow read: if isStoreOwner(storeId) || (canAccessStore(storeId) && hasPermission('viewDashboardStats')) || isAdmin();
        allow write: if isStoreOwner(storeId) || (canAccessStore(storeId) && (hasPermission('createTransaction') || hasPermission('createDebt') || hasPermission('collectDebt'))) || isAdmin();
      }
      match /pin_locks/{hashedPin} {
        allow read, write: if (isAuthenticated() && (isStoreOwner(storeId) || isStoreEmployee(storeId))) || isAdmin();
      }
    }

    // ==========================================
    // 4. العمليات المالية 
    // ==========================================
    
    // 🌟 التعديل السحري: ضفنا isStoreOwner في الأول عشان يعدي المالك في المحافظ والمعاملات
    match /wallets/{walletId} {
      allow get: if canAccessStore(resource.data.storeId) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow create: if isStoreOwner(request.resource.data.storeId) || (canAccessStore(request.resource.data.storeId) && hasPermission('createWallet')) || isAdmin();
      allow update: if isStoreOwner(resource.data.storeId) || (canAccessStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId && (hasPermission('editWallet') || hasPermission('addBalance'))) || isAdmin();
      allow delete: if isStoreOwner(resource.data.storeId) || isAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if canAccessStore(resource.data.storeId) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow create: if isStoreOwner(request.resource.data.storeId) || (canAccessStore(request.resource.data.storeId) && hasPermission('createTransaction')) || isAdmin();
      allow update: if isStoreOwner(resource.data.storeId) || (canAccessStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId && hasPermission('createTransaction')) || isAdmin();
      allow delete: if isAdmin(); 
    }

    match /debts/{debtId} {
      allow get: if canAccessStore(resource.data.storeId) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow create: if isStoreOwner(request.resource.data.storeId) || (canAccessStore(request.resource.data.storeId) && hasPermission('createDebt')) || isAdmin();
      allow update: if isStoreOwner(resource.data.storeId) || (canAccessStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId && (hasPermission('createDebt') || hasPermission('collectDebt'))) || isAdmin();
      allow delete: if isStoreOwner(resource.data.storeId) || isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow create: if isAuthenticated() || isAdmin();
      allow get, delete: if (isAuthenticated() && isStoreOwner(resource.data.storeId)) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow update: if isAdmin(); 
    }
    
    // ==========================================
    // 5. مسارات الإعدادات والإحصائيات الجديدة
    // ==========================================

    match /settings/{document=**} {
      // فتحناها للكل عشان التطبيق يفتح بدون مشاكل
      allow read: if true; 
      allow write: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /stats/{document=**} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // السماح للموبايل يزود العداد براحته
   match /stats/global {
      allow read: if request.auth != null;
      
      // السماح بالإنشاء لأول مرة لو المستند مش موجود
      allow create: if request.auth != null;
      
      // السماح بالتحديث فقط إذا كان التعديل هو زيادة العداد بـ 1
      allow update: if request.auth != null 
                    && request.resource.data.totalTransactions == resource.data.totalTransactions + 1;
    }
  }
}