rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. Core Security & Isolation Helpers
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && request.auth.uid == storeId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStoreEmployee(storeId) {
      return isUserDocExists() && getUserData().get('storeId', '') == storeId && getUserData().get('isActive', false) == true;
    }

    function canAccessStore(storeId) {
      return isStoreOwner(storeId) || isStoreEmployee(storeId);
    }

    function hasPermission(permissionName) {
      return isAuthenticated() && isUserDocExists() && (
        getUserData().get('role', '') == 'owner' || 
        (
          getUserData().get('role', '') == 'employee' && 
          getUserData().get('permissions', {}).get(permissionName, false) == true
        )
      );
    }

    // ==========================================
    // 2. Admin & System Rules
    // ==========================================
    
    match /admin_stats/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /device_registrations/{deviceId} {
      allow get: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.keys().hasAll(['deviceId', 'ownerUid']) && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update, delete, list: if isAdmin(); 
    }

    match /license_keys/{keyId} {
      allow read: if isAdmin(); 
      allow update: if (isAuthenticated() && !resource.data.isUsed) || isAdmin(); 
      allow create, delete: if isAdmin(); 
    }

    // ==========================================
    // 3. User Identity & Store Infrastructure
    // ==========================================

    match /users/{userId} {
      allow get: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow get, delete: if (isAuthenticated() && resource.data.storeId != null && isStoreOwner(resource.data.storeId)) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow create: if (isAuthenticated() && isStoreOwner(request.resource.data.storeId)) || (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow update: if isAdmin() 
                    || (isAuthenticated() && isStoreOwner(resource.data.storeId))
                    || (
                         isAuthenticated() 
                         && request.auth.uid == userId 
                         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'storeId', 'isActive'])
                             || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'updatedAt']))
                       );
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isStoreOwner(storeId) || isAdmin();
      allow delete: if isAdmin();

      match /stats/summary {
        allow read: if isStoreOwner(storeId) || (canAccessStore(storeId) && hasPermission('viewDashboardStats')) || isAdmin();
        allow write: if isStoreOwner(storeId) || (canAccessStore(storeId) && (hasPermission('createTransaction') || hasPermission('createDebt') || hasPermission('collectDebt'))) || isAdmin();
      }
      match /daily_stats/{day} {
        allow read: if isStoreOwner(storeId) || (canAccessStore(storeId) && hasPermission('viewDashboardStats')) || isAdmin();
        allow write: if isStoreOwner(storeId) || (canAccessStore(storeId) && (hasPermission('createTransaction') || hasPermission('createDebt') || hasPermission('collectDebt'))) || isAdmin();
      }
      match /pin_locks/{hashedPin} {
        allow read, write: if (isAuthenticated() && canAccessStore(storeId)) || isAdmin();
      }
    }

    // ==========================================
    // 4. Financial Collections (Isolated by Tenant)
    // ==========================================
    
    match /wallets/{walletId} {
      allow get, list: if canAccessStore(resource.data.storeId) || isAdmin();
      allow create: if isStoreOwner(request.resource.data.storeId) || (canAccessStore(request.resource.data.storeId) && hasPermission('createWallet')) || isAdmin();
      allow update: if isStoreOwner(resource.data.get('storeId', '')) || 
                   isStoreOwner(request.resource.data.storeId) || 
                   (canAccessStore(resource.data.get('storeId', '')) && 
                    request.resource.data.storeId == resource.data.get('storeId', '') && 
                    (hasPermission('editWallet') || 
                     hasPermission('addBalance') || 
                     hasPermission('createTransaction') || 
                     hasPermission('createDebt') || 
                     hasPermission('collectDebt'))) || 
                   isAdmin();
      allow delete: if isStoreOwner(resource.data.storeId) || isAdmin();
    }

    match /transactions/{transactionId} {
      allow get, list: if canAccessStore(resource.data.storeId) || isAdmin();
      allow create: if isStoreOwner(request.resource.data.storeId) || (canAccessStore(request.resource.data.storeId) && hasPermission('createTransaction')) || isAdmin();
      allow update: if isStoreOwner(resource.data.storeId) || (canAccessStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId && hasPermission('createTransaction')) || isAdmin();
      allow delete: if isAdmin(); 
    }

    match /debts/{debtId} {
      allow get, list: if canAccessStore(resource.data.storeId) || isAdmin();
      allow create: if isStoreOwner(request.resource.data.storeId) || (canAccessStore(request.resource.data.storeId) && hasPermission('createDebt')) || isAdmin();
      allow update: if isStoreOwner(resource.data.storeId) || (canAccessStore(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId && (hasPermission('createDebt') || hasPermission('collectDebt'))) || isAdmin();
      allow delete: if isStoreOwner(resource.data.storeId) || isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow create: if isAuthenticated() || isAdmin();
      allow get, delete: if (isAuthenticated() && isStoreOwner(resource.data.storeId)) || isAdmin();
      allow list: if isAuthenticated() || isAdmin();
      allow update: if isAdmin(); 
    }

    // ==========================================
    // 5. Configs & Global Metrics
    // ==========================================

    match /settings/{document=**} {
      allow read: if true; 
      allow write: if isUserDocExists() && getUserData().get('role', '') == 'admin';
    }
    
    match /stats/{document=**} {
      allow read, write: if isUserDocExists() && getUserData().get('role', '') == 'admin';
    }

    // Note: The wildcard match /stats/{document=**} above also matches /stats/global,
    // but Firestore evaluates BOTH match blocks independently. A request succeeds if
    // ANY matching rule grants access, so this specific rule effectively overrides
    // the admin-only wildcard for the /stats/global document.
    match /stats/global {
      allow read, write: if request.auth != null;
    }
  }
}