rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. دوال مساعدة أمنية (Security Helpers)
    // ==========================================
    
    // هل المستخدم مسجل دخول؟
    function isAuthenticated() {
      return request.auth != null;
    }

    // هل المستخدم هو "صاحب المتجر"؟ (بافتراض أن storeId هو نفس الـ UID الخاص بالمالك)
    function isStoreOwner(storeId) {
      return isAuthenticated() && request.auth.uid == storeId;
    }

    // هل المستخدم "موظف" في هذا المتجر؟ 
    // (نقوم بقراءة مستند المستخدم من قاعدة البيانات بأمان للتحقق من المتجر التابع له)
    function isStoreEmployee(storeId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId;
    }

    // هل يحق للمستخدم الوصول؟ (إما صاحب المتجر أو موظف فيه)
    function canAccessStore(storeId) {
      return isStoreOwner(storeId) || isStoreEmployee(storeId);
    }

    // ==========================================
    // 2. القواعد الأساسية (The Rules)
    // ==========================================

    // --- سجل الأجهزة (مكافحة الاحتيال) ---
    match /device_registrations/{deviceId} {
      // مسموح فقط قراءة جهاز محدد إذا كنت صاحب الجهاز (ownerUid)
      allow get: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      // السماح بالإنشاء مع ضرورة إرفاق الـ ownerUid الخاص بالمستخدم الحالي
      allow create: if isAuthenticated() && 
                       request.resource.data.keys().hasAll(['deviceId', 'ownerUid']) && 
                       request.resource.data.ownerUid == request.auth.uid;
      allow update, delete, list: if false; // سجل ثابت لا يمكن التلاعب فيه
    }

    // --- مفاتيح الترخيص القديمة ---
    match /license_keys/{keyId} {
      // Secure license_keys: Deny read access to all authenticated users (Report 2: C-7, M-10).
      // Verification should be handled via Admin SDK/Cloud Functions.
      allow read: if false;
      allow update: if isAuthenticated() && !resource.data.isUsed; 
      allow create, delete: if false;
    }

    // --- المستخدمين والموظفين ---
    match /users/{userId} {
      // المستخدم يقدر يشوف ويعدل بياناته هو شخصياً
      allow get, update: if isAuthenticated() && request.auth.uid == userId;
      
      // صاحب المتجر يقدر يقرأ، يضيف، أو يحذف الموظفين اللي تبع متجره
      // نستخدم request.resource للإنشاء والتعديل، و resource للقراءة والحذف
      allow read, delete: if isAuthenticated() && isStoreOwner(resource.data.storeId);
      allow create, update: if isAuthenticated() && isStoreOwner(request.resource.data.storeId);

      // السماح بإنشاء حساب لنفسك
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- المتاجر والإحصائيات ---
    match /stores/{storeId} {
      // القراءة للمالك والموظف
      allow read: if canAccessStore(storeId);
      
      // الإنشاء للمالك فقط
      allow create: if isStoreOwner(storeId);
      
      // التعديل للمالك فقط! (حماية لمنع الموظفين من ترقية الباقة أو تغيير اسم المتجر)
      allow update: if isStoreOwner(storeId); 
      allow delete: if false;

      // الإحصائيات الفرعية
      match /stats/summary {
        allow read, write: if canAccessStore(storeId);
      }
      match /daily_stats/{day} {
        allow read, write: if canAccessStore(storeId);
      }
    }

    // ==========================================
    // 3. العمليات المالية (المنطقة الحمراء)
    // ==========================================
    // هنا يجب التأكد أن المستند نفسه يحتوي على storeId وأن المستخدم ينتمي لهذا المتجر
    
    match /wallets/{walletId} {
      allow read: if canAccessStore(resource.data.storeId);
      allow create: if canAccessStore(request.resource.data.storeId);
      // نمنع نقل المحفظة من متجر لمتجر آخر أثناء التحديث
      allow update: if canAccessStore(resource.data.storeId) && 
                       request.resource.data.storeId == resource.data.storeId;
      // Change: Restrict delete to Owner (Axis 2/Phase 6)
      allow delete: if isStoreOwner(resource.data.storeId);
    }

    match /transactions/{transactionId} {
      allow read: if canAccessStore(resource.data.storeId);
      allow create: if canAccessStore(request.resource.data.storeId);
      allow update: if canAccessStore(resource.data.storeId) && 
                       request.resource.data.storeId == resource.data.storeId;
      // الحذف ممنوع نهائياً لضمان سلامة السجلات المالية
      allow delete: if false; 
    }

    match /debts/{debtId} {
      allow read: if canAccessStore(resource.data.storeId);
      allow create: if canAccessStore(request.resource.data.storeId);
      allow update: if canAccessStore(resource.data.storeId) && 
                       request.resource.data.storeId == resource.data.storeId;
      // Change: Restrict delete to Owner (Axis 2/Phase 6)
      allow delete: if isStoreOwner(resource.data.storeId);
    }

    // Subscription upgrade requests — authenticated users can create, only owners can read/delete
    match /subscription_requests/{requestId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null &&
                             isStoreOwner(resource.data.storeId);
      allow update: if false; // Immutable after creation; processed by backend
    }

    // PIN uniqueness lock documents — owned per store, written inside transactions
    match /stores/{storeId}/pin_locks/{hashedPin} {
      allow read, write: if request.auth != null &&
                            (isStoreOwner(storeId) || isStoreEmployee(storeId));
    }
  }
}
